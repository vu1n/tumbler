#!/usr/bin/env node
// tumbler — run a command with env vars from the tumbler broker. Values live only in the process
// you run and in a short-lived in-memory cache; nothing is written to disk.
//
//   tumbler run [-p project] [-k A,B] [--scope a,b] [--retry] [--watch] [--clean [--pass A,B]] -- <cmd> [args...]
//                                    --scope asks for more scopes on the set's minted keys
//                                    (e.g. workers:write); granted at once within the token's
//                                    scopes, refused outside them (the command doesn't start)
//                                    When the command fails, run refetches its keys and reports
//                                    which changed and which fail their check (names, never values)
//                                    --retry reruns it once with the new values, only if a key changed
//                                    --watch keeps a long-running command on current keys: when a
//                                    key whose new value passed its check on save changes, it
//                                    restarts the command with that value, and goes back to the old
//                                    one if the restart dies within TUMBLER_WATCH_GRACE seconds (10)
//                                    --clean starts the command from a runtime allowlist (PATH, HOME,
//                                    locale, proxy and CA settings...) plus its keys, instead of this
//                                    shell's whole environment; --pass A,B lets named variables through
//   tumbler keys [-p project]        names this caller can read (never values)
//   tumbler whoami                   which token the broker sees, and its pin
//   tumbler auto [-p project] [--dry-run] [--force]
//                                    work out which keys this repo needs and write .tumbler
//   tumbler reload                   drop the cache so the next run fetches fresh values
//   tumbler put NAME [-p project | --global] [--from-file PATH | --clipboard] [-d description]
//                                    save a static key, within the token's writes (set in /admin).
//                                    The value comes from the file, the clipboard, piped stdin, or a
//                                    hidden prompt (pasting works there, newlines included); never
//                                    from an argument. A single-line value loses its trailing newline;
//                                    a multi-line one (a private key) is kept exactly. Default scope:
//                                    -p, TUMBLER_PROJECT or .tumbler, else the token's one project
//   tumbler rm NAME [-p project | --global]
//                                    delete a static key, within the token's writes; same default scope
//   tumbler scope NAME [-p project] [--json]
//                                    a minted key's scopes and their permission groups (names/ids)
//   tumbler scope add|rm NAME SCOPE GROUP... [-p project]
//                                    add or remove permission groups on a minted key's scope (a new
//                                    scope name makes a new scope), for an operator token (set in
//                                    /admin). Only groups added this way can be removed; token,
//                                    member and billing groups are refused. Children holding the old
//                                    groups are ended, so the next run mints with the new ones
//   tumbler admin <command>          what /admin does (keys, tokens, pins, scopes, moves, grants,
//                                    audit), signed in through Cloudflare Access: `tumbler admin
//                                    login` runs cloudflared. `tumbler admin` lists the commands
//   tumbler ssh-keygen NAME [-p project | --global] [-C comment] [-d description]
//                                    make an ed25519 keypair in memory, save the private key as NAME
//                                    (as put does) and print the public key; nothing touches disk
//   tumbler shim <tool>...           install wrappers so <tool> always runs under `tumbler run`
//   tumbler url [URL]                print the broker's URL, or save it (~/.config/tumbler/url) so
//                                    TUMBLER_URL needn't be exported; with neither, the first command
//                                    at a terminal asks for it once and saves it
//   tumbler update                   replace this CLI with the one the broker serves at /cli. Every
//                                    broker answer names that version, and a CLI that differs says
//                                    so once on stderr (TUMBLER_UPDATE_CHECK=off quiets it)
//
// Config (environment): TUMBLER_URL (or `tumbler url`), TUMBLER_TOKEN (optional: leave unset when the
// environment's network secret adds the Authorization header), TUMBLER_TTL seconds (default 300,
// 0 disables the cache; an env with a minted key is cached at most 5 minutes), TUMBLER_PROJECT (default project), TUMBLER_WATCH seconds between --watch
// polls (default 30), TUMBLER_DIAGNOSE=off to skip the failure report. A `.tumbler` file in the working
// directory or any parent lists the key names a project wants, one per line, plus an optional
// `project = <name>` line. With no `.tumbler`, `run` writes one with `tumbler auto` first and passes
// only those keys; if auto fails the command doesn't start. A `.tumbler` auto writes is kept out of
// git (.git/info/exclude), so nobody has to review or commit it; commit one only to pin a set.
// TUMBLER_AUTO=off skips auto and fetches every key the token can read.
import { execFileSync, spawn } from "node:child_process";
import { createHash, generateKeyPairSync, randomBytes } from "node:crypto";
import { chmodSync, existsSync, mkdirSync, readdirSync, readFileSync, realpathSync, renameSync, unlinkSync, writeFileSync } from "node:fs";
import { createConnection, createServer } from "node:net";
import { constants, homedir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const SELF = fileURLToPath(import.meta.url);
const TTL = Number(process.env.TUMBLER_TTL ?? 300) * 1000;
const RUN_DIR = join(process.env.XDG_RUNTIME_DIR || join(homedir(), ".cache"), "tumbler");
// Why this file's own hash in the name: a helper started by another version of the CLI (before an
// upgrade through /setup) keeps that version's cache rules, so this one never asks it. It is left
// alone and exits once idle.
const VERSION = createHash("sha256").update(readFileSync(SELF)).digest("hex").slice(0, 12);
const SOCK = join(RUN_DIR, `cache-${process.getuid?.() ?? 0}-${VERSION}.sock`);
const SHIM_DIR = join(homedir(), ".local", "share", "tumbler", "bin");
const IDLE_EXIT = Number(process.env.TUMBLER_IDLE ?? 1800) * 1000; // the helper exits after this long unused

const die = (msg, code = 1) => { process.stderr.write(`tumbler: ${msg}\n`); process.exit(code); };

// --- talking to the broker -------------------------------------------------------------------

// Why curl: it honours HTTPS_PROXY and the proxy's CA bundle everywhere, which Node's fetch does
// not by default, and the agent proxy is what attaches the network secret.
// A bare host (TUMBLER_URL=tumbler.example.com) means https: plain http would miss the proxy's auth header.
const withScheme = u => u && !/^[a-z][a-z0-9+.-]*:\/\//i.test(u) ? "https://" + u : u;
const callerCfg = () => ({ url: withScheme(process.env.TUMBLER_URL), token: process.env.TUMBLER_TOKEN || "" });

function brokerGet(path, cfg = callerCfg()) { return brokerCall("GET", path, null, cfg); }

function brokerCall(method, path, body, { url: base, token, headers = [] } = callerCfg()) {
  if (!base) return Promise.reject(new Error("TUMBLER_URL is not set"));
  return new Promise((ok, fail) => {
    // Headers and body go in on stdin as a curl config, so neither a token (caller or Access) nor a
    // value `put` sends ever shows up in `ps`.
    const args = ["-sS", "--max-time", "15", "-X", method, "-K", "-", "-w", "\n%header{x-tumbler-cli}\n%{http_code}"];
    const child = spawn("curl", [...args, base.replace(/\/$/, "") + path], { stdio: ["pipe", "pipe", "pipe"] });
    let stdout = "", stderr = "";
    child.stdout.on("data", (d) => { stdout += d; });
    child.stderr.on("data", (d) => { stderr += d; });
    child.on("error", fail);
    child.on("close", (code) => {
      if (code !== 0 && !/\n[1-9]\d\d$/.test(stdout)) return fail(new Error(stderr.trim() || `curl exited ${code}`)); // no HTTP status: say why
      const i = stdout.lastIndexOf("\n"), status = Number(stdout.slice(i + 1)), j = stdout.lastIndexOf("\n", i - 1);
      const text = stdout.slice(0, Math.max(j, 0)), served = stdout.slice(j + 1, i);
      lastServed = served;
      noticeStale(served);
      let parsed; try { parsed = JSON.parse(text); } catch { parsed = { error: text.slice(0, 200) }; }
      status >= 200 && status < 300 ? ok(parsed) : fail(new Error(`broker ${status}: ${parsed.error ?? "error"}`));
    });
    child.stdin.on("error", () => {}); // curl can exit before reading; its status reports why
    // A quoted config string: curl unescapes \\ and \" (and \n, so JSON's own escapes are doubled).
    const q = (v) => `"${v.replace(/\\/g, "\\\\").replace(/"/g, '\\"')}"`, conf = [];
    if (token) conf.push(`header = ${q(`Authorization: Bearer ${token}`)}`);
    for (const h of headers) conf.push(`header = ${q(h)}`);
    if (body !== null) conf.push(`header = ${q("Content-Type: application/json")}`, `data-binary = ${q(JSON.stringify(body))}`);
    child.stdin.end(conf.join("\n") + "\n");
  });
}

// The broker names the CLI it serves on every /v1 answer; a different one here means this copy is
// stale (a flag it doesn't know yet, a route it calls wrong). Said once per process, on stderr; the
// cache helper's stderr goes nowhere, so it hands the version back with the env for the caller to say.
let staleSaid = false, lastServed = "";
function noticeStale(served) {
  if (staleSaid || !/^[0-9a-f]{12}$/.test(served) || served === VERSION || process.env.TUMBLER_UPDATE_CHECK === "off") return;
  staleSaid = true;
  process.stderr.write(`tumbler: this CLI (${VERSION}) differs from the broker's (${served}); run \`tumbler update\`\n`);
}

// Replaces this file with the CLI the broker serves at /cli, in place (through symlinks), after
// checking it parses: a broken download never replaces a working CLI.
async function update() {
  const base = callerCfg().url ?? die("TUMBLER_URL is not set");
  const target = realpathSync(SELF), tmp = join(dirname(target), `.tumbler-update-${process.pid}`);
  try {
    execFileSync("curl", ["-fsSL", "--max-time", "30", "-o", tmp, base.replace(/\/$/, "") + "/cli"], { stdio: ["ignore", "ignore", "pipe"] });
  } catch (e) {
    try { unlinkSync(tmp); } catch {}
    die(e.code === "ENOENT" ? "curl isn't installed" : /Permission denied|Read-only/i.test(String(e.stderr)) ? `can't write ${dirname(target)}; run it with sudo` : `could not fetch ${base}/cli (${String(e.stderr).trim() || e.message})`);
  }
  const body = readFileSync(tmp);
  try {
    if (!body.toString("utf8", 0, 20).startsWith("#!/usr/bin/env node")) throw new Error("not the tumbler CLI");
    execFileSync(process.execPath, ["--check", tmp], { stdio: "ignore" });
  } catch (e) { unlinkSync(tmp); die(`the broker's /cli didn't check out (${e.message}); nothing was changed`); }
  const next = createHash("sha256").update(body).digest("hex").slice(0, 12);
  if (next === VERSION) { unlinkSync(tmp); return say(`already current (${VERSION})`); }
  chmodSync(tmp, 0o755);
  renameSync(tmp, target);
  say(`updated ${target} from ${VERSION} to ${next}`);
}

const envPath = (project, keys) => {
  const q = new URLSearchParams();
  if (project) q.set("project", project);
  if (keys.length) q.set("keys", keys.join(","));
  const s = q.toString();
  return "/v1/env" + (s ? `?${s}` : "");
};

// --- the in-memory cache (a lazily started helper on a private unix socket) ------------------

function daemon() {
  mkdirSync(RUN_DIR, { recursive: true, mode: 0o700 });
  chmodSync(RUN_DIR, 0o700);
  const cache = new Map();
  let idle = setTimeout(() => process.exit(0), IDLE_EXIT);
  const server = createServer((sock) => {
    clearTimeout(idle); idle = setTimeout(() => process.exit(0), IDLE_EXIT);
    let buf = "";
    sock.on("data", async (d) => {
      buf += d;
      if (!buf.includes("\n")) return;
      const reply = (o) => sock.end(JSON.stringify(o) + "\n");
      try {
        const req = JSON.parse(buf);
        if (req.op === "reload") { cache.clear(); return reply({ ok: true }); }
        // Why: the cache is keyed by broker and token too, so a caller with another token never
        // gets values fetched for someone else.
        const path = envPath(req.project, req.keys), slot = createHash("sha256").update(`${req.url}\0${req.token}\0${path}`).digest("hex");
        const hit = cache.get(slot);
        // Why: the caller's TTL, not the one the helper started with, so lowering it takes effect. An
        // env with a minted child also carries the broker's max_age, so it never outlives the child.
        if (hit && !req.fresh && Date.now() - hit.at < Math.min(req.ttl, hit.maxAge)) return reply({ env: hit.env, cli: hit.cli });
        const { env, max_age } = await brokerGet(path, { url: req.url, token: req.token });
        cache.set(slot, { at: Date.now(), env, cli: lastServed, maxAge: max_age === undefined ? Infinity : Number(max_age) * 1000 });
        reply({ env, cli: lastServed });
      } catch (e) { reply({ error: e.message }); }
    });
  });
  if (existsSync(SOCK)) unlinkSync(SOCK);
  const old = process.umask(0o077);
  server.listen(SOCK, () => process.umask(old));
}

function ask(req) {
  return new Promise((ok, fail) => {
    const sock = createConnection(SOCK);
    let buf = "";
    sock.on("connect", () => sock.write(JSON.stringify(req) + "\n"));
    sock.on("data", (d) => { buf += d; });
    sock.on("end", () => { try { ok(JSON.parse(buf)); } catch (e) { fail(e); } });
    sock.on("error", fail);
  });
}

async function cached(req) {
  try { return await ask(req); } catch {}
  spawn(process.execPath, [SELF, "__daemon"], { detached: true, stdio: "ignore", env: process.env }).unref();
  for (let i = 0; i < 40; i++) {
    await new Promise((r) => setTimeout(r, 50));
    try { return await ask(req); } catch {}
  }
  return null; // helper didn't come up; caller fetches directly
}

// `fresh` skips a cached copy (and refreshes it), as a failed run's report needs.
async function fetchEnv(project, keys, fresh = false) {
  if (TTL > 0) {
    const r = await cached({ op: "get", project, keys, ttl: TTL, fresh, ...callerCfg() });
    if (r?.error) throw new Error(r.error);
    if (r?.cli) noticeStale(r.cli);
    if (r?.env) return r.env;
  }
  return (await brokerGet(envPath(project, keys))).env;
}

// --- auto: which keys this repo needs ---------------------------------------------------------

const SKIP_DIRS = new Set(["node_modules", ".git", "dist", "build", "target", "vendor", ".venv", "venv", "__pycache__", ".wrangler", ".next"]);

function repoRoot() {
  for (let dir = process.cwd(); ; dir = dirname(dir)) {
    if (existsSync(join(dir, ".git"))) return dir;
    if (dirname(dir) === dir) return process.cwd();
  }
}

// Files that carry the signals rules and dependencies come from. They are kept whatever the repo's
// size; other paths only fill what room is left (the broker keeps the first MAX_SIGNALS).
const KEY_FILE = /^(package\.json|requirements.*\.txt|pyproject\.toml|go\.mod|Cargo\.toml|wrangler\.(jsonc?|toml)|serverless\.ya?ml|samconfig\.toml|cdk\.json|tailscale.*)$/;
const MAX_WALK = 20000, MAX_OTHER_FILES = 200;

// File paths (three levels deep) and dependency names. Names only: nothing a file contains beyond
// its dependency list leaves this machine.
function gatherSignals(root) {
  const files = [], deps = new Set();
  const walk = (dir, rel, depth) => {
    let entries; try { entries = readdirSync(dir, { withFileTypes: true }); } catch { return; }
    for (const e of entries) {
      if (files.length >= MAX_WALK) return;
      const r = rel ? `${rel}/${e.name}` : e.name;
      if (e.isDirectory()) { if (!SKIP_DIRS.has(e.name) && depth < 3) walk(join(dir, e.name), r, depth + 1); }
      else if (e.isFile()) files.push(r);
    }
  };
  walk(root, "", 0);
  const read = (f) => { try { return readFileSync(join(root, f), "utf8"); } catch { return ""; } };
  for (const f of files) {
    const base = f.split("/").pop();
    if (base === "package.json") {
      try { const j = JSON.parse(read(f)); for (const k of ["dependencies", "devDependencies", "peerDependencies"]) for (const d of Object.keys(j[k] ?? {})) deps.add(d); } catch {}
    } else if (/^requirements.*\.txt$/.test(base)) {
      for (const line of read(f).split("\n")) { const m = /^\s*([A-Za-z0-9_.-]+)/.exec(line); if (m) deps.add(m[1]); }
    } else if (base === "pyproject.toml") {
      for (const d of pyprojectDeps(read(f))) deps.add(d);
    } else if (base === "go.mod") {
      for (const m of read(f).matchAll(/^\s*(?:require\s+)?([a-z0-9.-]+\.[a-z]+\/[^\s]+)\s+v/gm)) deps.add(m[1]);
    } else if (base === "Cargo.toml") {
      const sec = /\[(?:dev-)?dependencies\]([^\[]*)/g;
      for (const m of read(f).matchAll(sec)) for (const d of m[1].matchAll(/^\s*([A-Za-z0-9_-]+)\s*=/gm)) deps.add(d[1]);
    }
  }
  const isKey = (f) => KEY_FILE.test(f.split("/").pop()) || f.startsWith(".github/workflows/");
  const keyFiles = files.filter(isKey), others = files.filter((f) => !isKey(f)).slice(0, MAX_OTHER_FILES);
  return [...keyFiles.map((f) => `file:${f}`), ...[...deps].map((d) => `dep:${d}`), ...others.map((f) => `file:${f}`)];
}

// Every dependency a pyproject.toml declares: PEP 621 `dependencies` and `optional-dependencies`,
// PEP 735 `dependency-groups` and uv's `dev-dependencies` (arrays of PEP 508 strings, inline or one
// per line), and Poetry's dependency tables (one name per key). Why the extras too: an optional
// extra is often exactly where an API client lives (brief's and kypp's `s1 = ["typesafe-sdk"]`).
function pyprojectDeps(text) {
  const out = [];
  let table = "", open = false;
  for (const line of text.split("\n")) {
    let rest = line;
    if (!open) {
      const h = /^\s*\[([^\]]+)\]\s*(?:#.*)?$/.exec(line);
      if (h) { table = h[1].trim(); continue; }
      const kv = /^\s*(["']?)([A-Za-z0-9_.-]+)\1\s*=\s*(.*)$/.exec(line);
      if (!kv) continue;
      const key = kv[2];
      if (/^tool\.poetry\.(?:.+\.)?(?:dev-)?dependencies$/.test(table)) { if (key !== "python") out.push(key); continue; }
      const listed = (table === "project" && key === "dependencies") || table === "project.optional-dependencies"
        || table === "dependency-groups" || (table === "tool.uv" && key === "dev-dependencies");
      if (!listed || !kv[3].trimStart().startsWith("[")) continue;
      rest = kv[3]; open = true;
    }
    const { code, strings } = tomlLine(rest);
    for (const str of strings) { const m = /^\s*([A-Za-z0-9_.-]+)\s*(?:[<>=~!;\[@ ,(]|$)/.exec(str); if (m) out.push(m[1]); }
    if (code.includes("]")) open = false;
  }
  return out;
}

// One line of TOML split into the text outside strings (comment dropped) and the strings' contents.
// Why quote-aware: a `#` or `]` inside a string (`"pkg[s1] @ git+https://host/x#egg=pkg"`) is neither
// a comment nor the end of an array, and misreading either drops the dependencies after it.
function tomlLine(line) {
  let code = "", cur = null, quote = null;
  const strings = [];
  for (let i = 0; i < line.length; i++) {
    const c = line[i];
    if (quote) {
      if (c === "\\" && quote === '"') { cur += line[++i] ?? ""; continue; }
      if (c === quote) { strings.push(cur); quote = null; continue; }
      cur += c;
    } else if (c === '"' || c === "'") { quote = c; cur = ""; }
    else if (c === "#") break;
    else code += c;
  }
  return { code, strings };
}

async function autoPick(project) {
  const q = project ? `?project=${encodeURIComponent(project)}` : "";
  return brokerCall("POST", `/v1/auto${q}`, { signals: gatherSignals(repoRoot()) });
}

// Why `project` is the one asked for, never the broker's answer: that answer is the pin of whichever
// token ran auto, and a committed `project =` line made from it 403s for every other token (a
// global-only one, or one pinned elsewhere). A single-pin token gets its pin without the line.
function writeManifest(path, r, project) {
  const lines = ["# Written by `tumbler auto` from this repo's file and dependency names. Edit it if you like; git ignores it."];
  if (project) lines.push(`project = ${project}`);
  for (const k of r.keys) lines.push(`${k.name}  # ${k.why}`);
  writeFileSync(path, lines.join("\n") + "\n");
  keepOutOfGit(path);
}

// A written .tumbler is the CLI's working note, not part of the change: list it in the repo's own
// info/exclude (asked of git, so a worktree or submodule finds its real one) so it never shows up
// as untracked. Best effort: no git, no exclude.
function keepOutOfGit(path) {
  try {
    const cwd = dirname(path);
    const exclude = resolve(cwd, execFileSync("git", ["rev-parse", "--git-path", "info/exclude"], { cwd, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim());
    const have = existsSync(exclude) ? readFileSync(exclude, "utf8") : "";
    if (have.split("\n").some((l) => l.trim() === "/.tumbler")) return;
    mkdirSync(dirname(exclude), { recursive: true });
    writeFileSync(exclude, have + (have && !have.endsWith("\n") ? "\n" : "") + "/.tumbler\n");
  } catch {}
}

async function auto(args) {
  const dry = args.includes("--dry-run"), force = args.includes("--force");
  const { project } = parseFlags(args.filter((a) => a !== "--dry-run" && a !== "--force"));
  const path = join(repoRoot(), ".tumbler");
  if (!dry && !force && existsSync(path)) die(`${path} exists; pass --force to rewrite it`, 2);
  let r; try { r = await autoPick(project); } catch (e) { die(e.message); }
  for (const k of r.keys) process.stdout.write(`${k.name}\t${k.why}\n`);
  if (!r.keys.length) process.stdout.write("no keys needed\n");
  if (!dry) { writeManifest(path, r, project); process.stderr.write(`tumbler: wrote ${path}\n`); }
}

// --- project manifest ------------------------------------------------------------------------

function manifest() {
  for (let dir = process.cwd(); ; dir = dirname(dir)) {
    const f = join(dir, ".tumbler");
    if (existsSync(f)) {
      const out = { found: true, project: null, keys: [] };
      for (const raw of readFileSync(f, "utf8").split("\n")) {
        const line = raw.replace(/#.*/, "").trim();
        if (!line) continue;
        const m = /^project\s*=\s*(\S+)$/.exec(line);
        if (m) out.project = m[1]; else out.keys.push(line);
      }
      return out;
    }
    if (dirname(dir) === dir) return { found: false, project: null, keys: [] };
  }
}

function parseFlags(args) {
  const m = manifest();
  let project = process.env.TUMBLER_PROJECT || m.project, keys = m.keys, rest = [], picked = m.found, scopes = [], retry = false, watch = false, clean = false, pass = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === "--") { rest = args.slice(i + 1); break; }
    if (a === "-p" || a === "--project") project = args[++i];
    else if (a === "-k" || a === "--keys") { keys = String(args[++i] ?? "").split(",").map((s) => s.trim()).filter(Boolean); picked = true; }
    else if (a === "--scope") scopes.push(...String(args[++i] ?? "").split(",").map((s) => s.trim()).filter(Boolean));
    else if (a === "--retry") retry = true;
    else if (a === "--watch") watch = true;
    else if (a === "--clean") clean = true;
    else if (a === "--pass") pass.push(...String(args[++i] ?? "").split(",").map((s) => s.trim()).filter(Boolean));
    else { rest = args.slice(i); break; }
  }
  return { project, keys, rest, picked, scopes, retry, watch, clean, pass };
}

// --- commands --------------------------------------------------------------------------------

function realBinary(tool) {
  // The first `tool` on PATH that isn't one of our shims, or a link to one (setup.sh links them
  // into ~/.local/bin, which agent shells have on PATH without reading a profile).
  const shims = existsSync(SHIM_DIR) ? realpathSync(SHIM_DIR) : SHIM_DIR;
  for (const dir of (process.env.PATH ?? "").split(":")) {
    if (!dir || resolve(dir) === SHIM_DIR) continue;
    const p = join(dir, tool);
    if (existsSync(p) && dirname(realpathSync(p)) !== shims) return p;
  }
  return null;
}

// Ask the broker for more scopes on the minted keys in the set. A refusal (a scope outside the
// token's scopes) stops the run: the command never starts with a narrower token than it asked for.
async function stepUp(project, keys, scopes) {
  let names = keys, failed = null;
  try {
    if (!names) names = (await brokerGet("/v1/keys" + (project ? `?project=${encodeURIComponent(project)}` : ""))).keys;
    const r = await brokerCall("POST", "/v1/step-up" + (project ? `?project=${encodeURIComponent(project)}` : ""), { keys: names, scopes });
    const short = r.grants.filter((g) => g.state !== "active");
    if (short.length) failed = short.map((g) => `${g.name}: not active yet (grant ${g.id}); run again`).join("\n          ");
  } catch (e) { failed = e.message; }
  // Reload even on a failure: the cached env holds the narrower child, which a step-up that failed
  // partway (a later key's mint) may already have deleted.
  try { await ask({ op: "reload" }); } catch {}
  if (failed) die(failed);
}

async function run(args) {
  let { project, keys, rest, picked, scopes, retry, watch, clean, pass } = parseFlags(args);
  if (!rest.length) die("usage: tumbler run [-p project] [-k A,B] [--scope a,b] [--retry] [--watch] [--clean [--pass A,B]] -- <cmd> [args...]", 2);
  if (pass.length && !clean) die("--pass only applies with --clean", 2);
  if (clean) inherited = cleanEnv(pass);
  // No .tumbler and no -k: work the set out once and write it down, so later runs and reviewers see it.
  if (!picked && !["0", "off", "false", "no"].includes((process.env.TUMBLER_AUTO ?? "").toLowerCase())) {
    // Why: neither failure may widen the set to every key the token can read. If auto can't pick,
    // the command doesn't start; if the pick can't be saved (read-only checkout), it still runs with
    // exactly the picked keys.
    let r;
    try { r = await autoPick(project); } catch (e) {
      die(`auto could not pick keys (${e.message}); pass -k A,B, add a .tumbler, or set TUMBLER_AUTO=off for every key`);
    }
    keys = r.keys.map((k) => k.name); picked = true;
    const path = join(repoRoot(), ".tumbler");
    try {
      writeManifest(path, r, project);
      process.stderr.write(`tumbler: wrote ${path} with ${keys.length} key(s); edit it to change what runs get\n`);
    } catch (e) {
      process.stderr.write(`tumbler: could not write ${path} (${e.code ?? e.message}); running with the ${keys.length} picked key(s) only\n`);
    }
  }
  if (scopes.length) await stepUp(project, picked ? keys : null, scopes);
  // Why: an empty picked set means "none", not "everything" (which is what /v1/env does with no keys).
  const load = (fresh) => picked && !keys.length ? Promise.resolve({}) : fetchEnv(project, keys, fresh);
  const q = project ? `?project=${encodeURIComponent(project)}` : "";
  const revsPath = `/v1/revs${q}${picked && keys.length ? `${q ? "&" : "?"}keys=${encodeURIComponent(keys.join(","))}` : ""}`;
  // Why revisions first and values past the cache: a key rotated between the two is then seen on the
  // first poll, instead of the command keeping a stale value that --watch never notices.
  let env, known = null;
  if (watch) { try { known = (await brokerGet(revsPath)).keys; } catch (e) { say(`--watch is off: ${e.message}`); } }
  try { env = await load(!!known); } catch (e) { die(e.message); }
  // Why: under a shim, `rest[0]` is the shim's own name; resolve past the shim dir so it can't loop.
  const cmd = process.env.TUMBLER_SHIMMED ? realBinary(rest[0]) ?? die(`no ${rest[0]} on PATH outside the shims`, 127) : rest[0];
  const state = { env, child: start(cmd, rest.slice(1), env), interrupted: false };
  // A stop from the user or a supervisor: forwarded, and from then on nothing restarts or reruns.
  const forward = ["SIGINT", "SIGTERM", "SIGHUP"].map((sig) => [sig, () => { state.interrupted = true; state.child.kill(sig); }]);
  for (const [sig, fn] of forward) process.on(sig, fn);
  let r = known ? await watching(state, revsPath, known, load, cmd, rest.slice(1)) : await state.child.done;
  if ((r.code || r.sig) && !state.interrupted && !["0", "off", "false", "no"].includes((process.env.TUMBLER_DIAGNOSE ?? "").toLowerCase()) && Object.keys(state.env).length) {
    const changed = await diagnose(r.code ? `exited ${r.code}` : `was killed by ${r.sig}`, state.env, q, load, retry);
    if (retry && changed && !state.interrupted) r = await (state.child = start(cmd, rest.slice(1), changed)).done;
  }
  if (r.error) die(`${rest[0]}: ${r.error.message}`, 127);
  if (!r.sig) process.exit(r.code ?? 1);
  // Why: drop our forwarders first, or they'd swallow the re-raised signal and we'd exit 0.
  for (const [s, fn] of forward) process.off(s, fn);
  process.kill(process.pid, r.sig);
  process.exit(128 + (constants.signals[r.sig] ?? 1)); // in case the signal is ignored here
}

const say = (msg) => process.stderr.write(`tumbler: ${msg}\n`);
const sleep = (ms) => new Promise((ok) => setTimeout(ok, ms).unref());

// What the command inherits besides its keys: this shell's environment, or under --clean only what a
// program needs to run and reach the network. Why opt-in: by default the keys are added to the
// environment, so a credential already exported in the shell still reaches the command.
// Environment only: it doesn't stop the command reading a dotenv file or a credentials directory.
let inherited = process.env;
const RUNTIME_VARS = /^(PATH|HOME|USER|LOGNAME|SHELL|TERM|COLORTERM|LANG|LANGUAGE|LC_[A-Z]+|TZ|TMPDIR|TEMP|TMP|PWD|XDG_[A-Z_]+|(?:HTTPS?|NO|ALL)_PROXY|(?:https?|no|all)_proxy|SSL_CERT_(?:FILE|DIR)|NODE_EXTRA_CA_CERTS|REQUESTS_CA_BUNDLE|CURL_CA_BUNDLE|TUMBLER_URL|SYSTEMROOT|COMSPEC|PATHEXT)$/;
function cleanEnv(pass) {
  return Object.fromEntries(Object.entries(process.env).filter(([k]) => RUNTIME_VARS.test(k) || pass.includes(k)));
}

// The command, with `done` settling once it exits: {code, sig} or {error} when it couldn't start.
function start(cmd, argv, env) {
  const child = spawn(cmd, argv, { stdio: "inherit", env: { ...inherited, ...env, TUMBLER_SHIMMED: "" } });
  child.done = new Promise((ok) => { child.on("exit", (code, sig) => ok({ code, sig })); child.on("error", (error) => ok({ error })); });
  return child;
}

// Only the command itself: a process it started in turn (sh -c, npm) may outlive it.
async function stop(child) {
  if (child.exitCode === null && child.signalCode === null) {
    child.kill("SIGTERM");
    if (!await Promise.race([child.done, sleep(10_000).then(() => null)])) child.kill("SIGKILL");
  }
  return child.done;
}

// A failed command: refetch its keys, name the ones that changed and run each key's check, so the
// report says whether a key is the likely cause. Names and statuses only, never a value.
// Returns the new env when a key changed (for --retry), otherwise null.
async function diagnose(how, used, q, load, retry) {
  say(`the command ${how}; checking its keys`);
  let fresh = null, checks = {};
  try { fresh = await load(true); } catch (e) { say(`  could not refetch them (${e.message})`); }
  const names = Object.keys(used).sort();
  // In batches of 20, the most /v1/check takes at once.
  try { for (let i = 0; i < names.length; i += 20) Object.assign(checks, (await brokerCall("POST", `/v1/check${q}`, { keys: names.slice(i, i + 20) })).checks); }
  catch (e) { say(`  could not run their checks (${e.message})`); }
  const changed = fresh ? names.filter((n) => fresh[n] !== used[n]) : [];
  const failing = names.filter((n) => checks[n]?.status === "invalid"), checked = names.filter((n) => checks[n] && checks[n].status !== "none");
  for (const n of names) {
    const c = checks[n], parts = [];
    if (changed.includes(n)) parts.push("changed since the command started");
    // A minted key's check tests its parent; the child the command held can still have expired.
    const who = c?.of === "parent" ? "its parent " : "";
    if (c?.status === "ok") parts.push(`${who}passes its check`);
    else if (c?.status === "invalid") parts.push(`${who}fails its check: ${c.detail}`);
    else if (c?.status === "error") parts.push(c.detail);
    else if (c?.status === "none") parts.push("has no check");
    if (parts.length) say(`  ${n} ${parts.join("; ")}`);
  }
  if (changed.length) say(retry ? "a key changed; running once more with the new values" : "a key changed; run again, or pass --retry to rerun automatically");
  else if (failing.length) say(`${failing.join(", ")} ${failing.length === 1 ? "fails its check; rotate it" : "fail their checks; rotate them"} in /admin`);
  // Only claimed when the refetch worked, so "no key changed" was actually compared.
  else if (fresh && checked.length && checked.every((n) => checks[n].status === "ok")) {
    say(`no key changed and every checked key passes, so the failure is probably not a key problem${checked.length < names.length ? " (keys without a check can't be ruled out)" : ""}`);
  }
  return changed.length ? fresh : null;
}

// --watch: poll the keys' revisions, and restart the command when a key changes whose new value
// passed its check on save. A key saved unchecked is reported, never pushed. Returns the exit of
// the command once it ends on its own, or once it was stopped by a forwarded signal.
async function watching(state, path, known, load, cmd, argv) {
  const secs = (v, d) => Math.max(Number(v) || d, 0.2) * 1000; // never a busy loop against the broker
  const poll = secs(process.env.TUMBLER_WATCH, 30), grace = secs(process.env.TUMBLER_WATCH_GRACE, 10);
  for (;;) {
    const ended = await Promise.race([state.child.done, sleep(poll).then(() => null)]);
    if (ended || state.interrupted) return ended ?? state.child.done;
    let now;
    try { now = (await brokerGet(path)).keys; } catch { continue; } // the broker is down: keep what runs
    const changed = Object.keys(now).filter((n) => n in state.env && known[n] && now[n].rev !== known[n].rev);
    const seen = { ...known }; // to undo: a checked revision we fail to fetch stays pending for the next poll
    for (const n of changed) known[n] = now[n];
    let push = changed.filter((n) => now[n].checked);
    for (const n of changed.filter((n) => !now[n].checked)) say(`${n} changed but its new value wasn't checked when it was saved; keeping the old one (restart to pick it up)`);
    if (!push.length) continue;
    let fresh;
    try { fresh = await load(true); } catch (e) {
      say(`${push.join(", ")} changed but could not be fetched (${e.message}); keeping the old values and trying again next poll`);
      for (const n of push) known[n] = seen[n];
      continue;
    }
    // Why again: a save between the poll and the fetch may have put an unchecked value behind the
    // checked revision. Only a key still at that revision is pushed; the next poll sees the rest.
    // If that check fails, the rotation stays pending: undo known so the next poll fetches it again.
    try { const after = (await brokerGet(path)).keys; push = push.filter((n) => after[n]?.rev === now[n].rev); }
    catch { for (const n of push) known[n] = seen[n]; continue; }
    const prev = state.env, next = { ...prev };
    for (const n of push) if (n in fresh) next[n] = fresh[n];
    if (!push.length || state.interrupted) continue;
    say(`${push.join(", ")} changed; restarting the command with the new value${push.length > 1 ? "s" : ""}`);
    const stopped = await stop(state.child);
    if (state.interrupted) return stopped;
    state.env = next; state.child = start(cmd, argv, next);
    const early = await Promise.race([state.child.done, sleep(grace).then(() => null)]);
    if (early && state.interrupted) return early;
    if (early && (early.error || early.sig || early.code)) {
      // Why the old values: a value that passed its check can still break this command; keep it running.
      say(`the restarted command exited within ${grace / 1000}s; going back to the previous value${push.length > 1 ? "s" : ""} of ${push.join(", ")}`);
      state.env = prev; state.child = start(cmd, argv, prev);
    } else if (early) return early;
  }
}

// --- writing keys ------------------------------------------------------------------------------

// Where put writes: -p (or TUMBLER_PROJECT, or .tumbler's project), --global, or neither (the broker
// then uses the token's one project, or refuses). -p and --global together is a mistake, not a choice.
function writeFlags(args, usage, extra = {}) {
  let name = null, scope = null, global = false, desc, file = null, clip = false, comment = null;
  for (let i = 0; i < args.length; i++) {
    const a = args[i], val = () => args[++i] ?? die(`${a} needs a value\n${usage}`, 2);
    if (a === "-p" || a === "--project") scope = val();
    else if (a === "--global") global = true;
    else if (a === "-d" || a === "--description") desc = val();
    else if (extra.input && a === "--from-file") file = val();
    else if (extra.input && a === "--clipboard") clip = true;
    else if (extra.comment && a === "-C") comment = val();
    else if (!a.startsWith("-") && name === null) name = a;
    else die(`unexpected ${a}\n${usage}`, 2);
  }
  if (!name) die(usage, 2);
  if (!/^[A-Z_][A-Z0-9_]{0,127}$/.test(name)) die(`invalid key name ${name}; names are UPPER_SNAKE_CASE`, 2);
  if (global && scope) die("pass -p or --global, not both", 2);
  if (file && clip) die("pass --from-file or --clipboard, not both", 2);
  if (global) scope = "global";
  else if (!scope) scope = process.env.TUMBLER_PROJECT || manifest().project || null;
  return { name, scope, desc, file, clip, comment };
}

// The clipboard, from the first paste tool this machine has.
function clipboard() {
  for (const [cmd, ...argv] of [["pbpaste"], ["wl-paste", "-n"], ["xclip", "-selection", "clipboard", "-o"], ["xsel", "-b", "-o"]]) {
    try { return execFileSync(cmd, argv, { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"], maxBuffer: 1 << 20 }); }
    catch (e) { if (e.code !== "ENOENT") die(`${cmd} failed; copy the value again, or pipe it in`); }
  }
  die("no clipboard tool found (pbpaste, wl-paste, xclip, xsel); pipe the value in or pass --from-file");
}

async function readStdin() {
  let v = "";
  for await (const c of process.stdin) v += c;
  return v;
}

// A hidden prompt. Bracketed paste lets a multi-line paste (a private key) through whole; outside a
// paste, Enter finishes. Nothing is echoed.
function prompt(label) {
  const PASTE_ON = "\x1b[200~", PASTE_OFF = "\x1b[201~", tty = process.stdin;
  tty.setRawMode(true); tty.setEncoding("utf8"); tty.resume(); // raw before the prompt shows, so nothing typed is echoed
  process.stderr.write(`${label} (hidden; paste works, Enter to finish): \x1b[?2004h`);
  return new Promise((ok) => {
    let value = "", pasting = false, held = "";
    const end = (code) => {
      tty.setRawMode(false); tty.pause(); tty.off("data", onData);
      process.stderr.write("\x1b[?2004l\n");
      code === undefined ? ok(value) : process.exit(code);
    };
    const onData = (chunk) => {
      // A paste marker split across reads is held until the rest arrives, or its first byte would be
      // dropped as an escape and a pasted newline would end the value early.
      let s = held + chunk;
      const esc = s.lastIndexOf("\x1b"), tail = esc < 0 ? "" : s.slice(esc);
      held = tail && tail.length < PASTE_ON.length && (PASTE_ON.startsWith(tail) || PASTE_OFF.startsWith(tail)) ? tail : "";
      if (held) s = s.slice(0, esc);
      for (let i = 0; i < s.length;) {
        if (s.startsWith(PASTE_ON, i)) { pasting = true; i += PASTE_ON.length; continue; }
        if (s.startsWith(PASTE_OFF, i)) { pasting = false; i += PASTE_OFF.length; continue; }
        const c = s[i++];
        if (pasting) { if (c !== "\r" || s[i] !== "\n") value += c === "\r" ? "\n" : c; continue; }
        if (c === "\r" || c === "\n") return end();
        if (c === "\x03") return end(130);
        if (c === "\x04" && !value) return end(1);
        if (c === "\x7f" || c === "\b") value = [...value].slice(0, -1).join("");
        else if (c === "\x1b") { // an arrow or other key's escape sequence, not input
          if (s[i] === "[" || s[i] === "O") { i++; while (/[0-9;?]/.test(s[i] ?? "")) i++; i++; }
        }
        else if (c >= " ") value += c;
      }
    };
    tty.on("data", onData);
  });
}

// A token pasted or echoed carries a trailing newline that isn't part of it; a private key's last
// newline is part of the file, so a multi-line value is kept exactly.
function trimValue(v) {
  const one = v.replace(/\r?\n$/, "");
  return one.includes("\n") ? v : one;
}

async function save({ name, scope, desc }, value, how, failNote = "") {
  if (!value) die(`empty value; ${how}`);
  let r;
  try { r = await brokerCall("PUT", `/v1/keys/${encodeURIComponent(name)}`, { value, ...(scope ? { scope } : {}), ...(desc !== undefined ? { description: desc } : {}) }); }
  catch (e) { die(e.message + failNote); }
  try { await ask({ op: "reload" }); } catch {} // so the next run sees it, not a cached older value
  say(`${r.action} ${r.name} in ${r.scope}${r.checked ? "; it passes its check" : ""}`);
}

const PUT_USAGE = "usage: tumbler put NAME [-p project | --global] [--from-file PATH | --clipboard] [-d description]";
// A value from the file, the clipboard, piped stdin or a hidden prompt, in that order. Never argv.
async function readValue({ name, file, clip }) {
  let value;
  if (file) { try { value = readFileSync(file, "utf8"); } catch (e) { die(`could not read ${file} (${e.code ?? e.message})`); } }
  else if (clip) value = clipboard();
  else if (!process.stdin.isTTY) value = await readStdin();
  else value = await prompt(`value for ${name}`);
  return trimValue(value);
}
const VALUE_HOW = "pipe it in, pass --from-file or --clipboard, or type it at the prompt";

async function put(args) {
  const f = writeFlags(args, PUT_USAGE, { input: true });
  await save(f, await readValue(f), VALUE_HOW);
}

async function rm(args) {
  const f = writeFlags(args, "usage: tumbler rm NAME [-p project | --global]");
  if (f.desc !== undefined) die("rm takes no description", 2);
  let r;
  try { r = await brokerCall("DELETE", `/v1/keys/${encodeURIComponent(f.name)}${f.scope ? `?scope=${encodeURIComponent(f.scope)}` : ""}`, null); }
  catch (e) { die(e.message); }
  try { await ask({ op: "reload" }); } catch {} // so the next run doesn't get it from the cache
  say(`deleted ${r.name} from ${r.scope}`);
}

// An ed25519 keypair in OpenSSH's own formats (PROTOCOL.key), made here so the private key never
// touches disk the way `ssh-keygen -f` would put it there.
function sshEd25519(comment) {
  const { d, x } = generateKeyPairSync("ed25519").privateKey.export({ format: "jwk" });
  const pub = Buffer.from(x, "base64url"), seed = Buffer.from(d, "base64url");
  const u32 = (n) => { const b = Buffer.alloc(4); b.writeUInt32BE(n); return b; };
  const str = (v) => { const b = Buffer.from(v); return Buffer.concat([u32(b.length), b]); };
  const blob = Buffer.concat([str("ssh-ed25519"), str(pub)]), check = randomBytes(4);
  const priv = Buffer.concat([check, check, str("ssh-ed25519"), str(pub), str(Buffer.concat([seed, pub])), str(comment)]);
  const pad = Buffer.from(Array.from({ length: (8 - priv.length % 8) % 8 }, (_, i) => i + 1));
  const body = Buffer.concat([Buffer.from("openssh-key-v1\0"), str("none"), str("none"), str(""), u32(1), str(blob), str(Buffer.concat([priv, pad]))]);
  return {
    private: `-----BEGIN OPENSSH PRIVATE KEY-----\n${body.toString("base64").replace(/.{1,70}/g, "$&\n")}-----END OPENSSH PRIVATE KEY-----\n`,
    public: `ssh-ed25519 ${blob.toString("base64")} ${comment}`,
  };
}

async function sshKeygen(args) {
  const f = writeFlags(args, "usage: tumbler ssh-keygen NAME [-p project | --global] [-C comment] [-d description]", { comment: true });
  const key = sshEd25519(f.comment ?? `tumbler:${f.name}`);
  // The public half first: a save that fails after the broker stored the key (a dropped response)
  // must not lose the only copy of the public key that matches it.
  process.stdout.write(key.public + "\n");
  await save(f, key.private, "", `\ntumbler: ${f.name} may or may not have been saved; the public key above matches it only if it was. Run this again before installing it anywhere.`);
}

// --- scope: an operator token's changes to a minted key's scopes --------------------------------

const SCOPE_USAGE = "usage: tumbler scope NAME [-p project] [--json] | tumbler scope add|rm NAME SCOPE GROUP... [-p project]";

async function scope(args) {
  let project = process.env.TUMBLER_PROJECT || manifest().project || null, json = false;
  const pos = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === "-p" || a === "--project") project = args[++i] ?? die(`${a} needs a value\n${SCOPE_USAGE}`, 2);
    else if (a === "--json") json = true;
    else if (a.startsWith("-")) die(`unexpected ${a}\n${SCOPE_USAGE}`, 2);
    else pos.push(a);
  }
  const verb = pos[0] === "add" || pos[0] === "rm" ? pos.shift() : null;
  const [name, scopeName, ...groups] = pos;
  if (!name || (verb ? !scopeName || !groups.length : pos.length > 1)) die(SCOPE_USAGE, 2);
  const path = `/v1/mint/${encodeURIComponent(name)}${project ? `?project=${encodeURIComponent(project)}` : ""}`;
  let r;
  try { r = verb ? await brokerCall("PATCH", path, { scope: scopeName, [verb === "add" ? "add" : "remove"]: groups }) : await brokerGet(path); }
  catch (e) { die(e.message); }
  if (verb) { try { await ask({ op: "reload" }); } catch {} } // so the next run mints with the new groups
  if (json) return void process.stdout.write(JSON.stringify(r) + "\n");
  if (verb) say(`${verb === "add" ? "added" : "removed"} ${groups.join(", ")} ${verb === "add" ? "to" : "from"} ${r.name} ${scopeName} (${r.scope})`);
  const rows = Object.entries(r.scopes).map(([s, g]) => `${s}\t${[...g.base, ...g.extra.map((e) => `+${e}`)].join(", ")}`);
  process.stdout.write(`${r.scope}/${r.name}${r.defaults ? " (follows the defaults)" : ""}\n${rows.join("\n")}\n`);
}

// --- admin: what /admin does, signed in through Cloudflare Access ---------------------------------

const ADMIN_USAGE = `usage: tumbler admin <command>
  login                                   sign in through Cloudflare Access (cloudflared)
  keys | tokens | grants | audit [--json] list them (names and metadata, never values)
  token create NAME [--pin a,b] [--scopes a,b] [--writes a,b] [--operator on|off] [--expires-hours N]
                                          prints the new token once, on stdout
  token edit NAME [--pin a,b] [--scopes a,b] [--writes a,b] [--operator on|off]   (an empty list clears it)
                                          --operator on: the token may change minted keys' groups
                                          with tumbler scope (never tokens, parents or token groups)
  token revoke NAME
  put NAME --scope S [--kind static|mint:<provider>] [--config JSON] [--from-file F | --clipboard]
      [-d description] [--skip-check]     any key, minted ones included; the value as for put
  rm NAME --scope S                       any key, minted ones included
  import FILE --scope S [--save]          a .env file; previews what it would do unless --save
  move FROM TO                            move a scope's keys and pins (huddles-dev to huddles/dev)
  grant revoke ID`;
const ACCESS_HINT = "sign in with `tumbler admin login`";

const adminApp = () => {
  const base = callerCfg().url;
  if (!base) die("TUMBLER_URL is not set");
  return base.replace(/\/$/, "") + "/admin";
};

// Why Access and not a token: an admin can mint any token, so admin stays tied to a person's Access
// sign-in (an email in TUMBLER_ADMINS), never to a bearer an agent could hold. cloudflared keeps the
// session; its JWT goes to curl on stdin, Access checks it at the edge and the Worker checks the
// assertion Access forwards (access.ts).
function accessJwt() {
  let jwt = "";
  try { jwt = execFileSync("cloudflared", ["access", "token", `-app=${adminApp()}`], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim(); }
  catch (e) { die(e.code === "ENOENT" ? "admin commands sign in through Cloudflare Access with cloudflared, which isn't installed" : `no Access session; ${ACCESS_HINT}`); }
  if (!/^[\w-]+\.[\w-]+\.[\w-]+$/.test(jwt)) die(`no Access session; ${ACCESS_HINT}`);
  return jwt;
}

async function adminCall(method, path, body = null) {
  try { return await brokerCall(method, `/admin/api/${path}`, body, { url: callerCfg().url, token: "", headers: [`cf-access-token: ${accessJwt()}`, "x-tumbler-admin: 1"] }); }
  catch (e) { die(/broker (302|401|403)\b/.test(e.message) ? `${e.message}; ${ACCESS_HINT}` : e.message); }
}

// Flags as {name: "value" | "bool"}; positionals in `_`. An unknown flag is a mistake, not ignored.
function adminFlags(args, spec) {
  const out = { _: [] };
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (!a.startsWith("-")) { out._.push(a); continue; }
    const kind = spec[a] ?? die(`unexpected ${a}\n${ADMIN_USAGE}`, 2);
    out[a] = kind === "bool" ? true : args[++i] ?? die(`${a} needs a value`, 2);
  }
  return out;
}
const names = (v) => String(v).split(",").map((s) => s.trim()).filter(Boolean);

// A table on stdout, or the broker's JSON with --json, for an agent to parse.
function table(rows, cols, json) {
  if (json) return void process.stdout.write(JSON.stringify(rows) + "\n");
  const cell = (v) => v === null || v === undefined ? "-" : Array.isArray(v) ? v.join(",") || "-" : String(v);
  process.stdout.write([cols.join("\t"), ...rows.map((r) => cols.map((c) => cell(r[c])).join("\t"))].join("\n") + "\n");
}

const ADMIN_LISTS = {
  keys: ["scope", "name", "kind", "checked", "rotated_at"], tokens: ["name", "projects", "scopes", "writes", "operator", "expires_at", "revoked_at"],
  grants: ["id", "name", "caller", "project", "state", "scopes", "expires_at"], audit: ["at", "actor", "action", "project", "names"],
};

async function admin(args) {
  const [sub, ...rest] = args;
  if (Object.hasOwn(ADMIN_LISTS, sub ?? "")) {
    const f = adminFlags(rest, { "--json": "bool" });
    const r = await adminCall("GET", sub);
    // Children whose deletion at the provider failed may still work until a retry or their expiry.
    if (r.revoke_pending) say(`${r.revoke_pending} revoked child credential(s) not yet deleted at the provider; retried every five minutes until they expire`);
    return table(r[sub], ADMIN_LISTS[sub], f["--json"]);
  }
  switch (sub) {
    case "login": {
      const r = spawn("cloudflared", ["access", "login", adminApp()], { stdio: "inherit" });
      r.on("error", (e) => die(e.code === "ENOENT" ? "cloudflared isn't installed; see https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/" : e.message));
      r.on("exit", (code) => process.exit(code ?? 1));
      return;
    }
    case "token": {
      const [verb, ...more] = rest;
      const f = adminFlags(more, { "--pin": "value", "--scopes": "value", "--writes": "value", "--operator": "value", "--expires-hours": "value" });
      const [name] = f._;
      if (!name || f._.length > 1) die(ADMIN_USAGE, 2);
      if (f["--operator"] !== undefined && !["on", "off"].includes(f["--operator"])) die("--operator takes on or off", 2);
      const operator = f["--operator"] === undefined ? {} : { operator: f["--operator"] === "on" };
      if (verb === "create") {
        const hours = f["--expires-hours"] === undefined ? null : Number(f["--expires-hours"]);
        if (hours !== null && !(hours > 0)) die("--expires-hours takes a number of hours", 2);
        const r = await adminCall("POST", "tokens", { name, projects: names(f["--pin"] ?? ""), scopes: names(f["--scopes"] ?? ""), writes: names(f["--writes"] ?? ""), ...operator,
          expires_at: hours === null ? null : new Date(Date.now() + hours * 3600_000).toISOString() });
        process.stdout.write(r.token + "\n");
        return say(`created token ${name}; it is shown once, so store it now (as a network secret, or TUMBLER_TOKEN)`);
      }
      if (verb === "edit") {
        const edit = {};
        for (const [flag, field] of [["--pin", "projects"], ["--scopes", "scopes"], ["--writes", "writes"]]) if (f[flag] !== undefined) edit[field] = names(f[flag]);
        Object.assign(edit, operator);
        if (!Object.keys(edit).length) die("name what to change: --pin, --scopes, --writes or --operator", 2);
        await adminCall("PATCH", `tokens/${encodeURIComponent(name)}`, edit);
        return say(`updated token ${name}`);
      }
      if (verb === "revoke") { await adminCall("DELETE", `tokens/${encodeURIComponent(name)}`); return say(`revoked token ${name}; the children it held are ended`); }
      return die(ADMIN_USAGE, 2);
    }
    case "put": {
      const f = adminFlags(rest, { "--scope": "value", "--kind": "value", "--config": "value", "--from-file": "value", "--clipboard": "bool", "-d": "value", "--description": "value", "--skip-check": "bool" });
      const [name] = f._;
      if (!name || f._.length > 1 || !f["--scope"]) die(ADMIN_USAGE, 2);
      if (f["--from-file"] && f["--clipboard"]) die("pass --from-file or --clipboard, not both", 2);
      let config;
      if (f["--config"] !== undefined) { try { config = JSON.parse(f["--config"]); } catch { die("--config takes JSON", 2); } }
      const value = await readValue({ name, file: f["--from-file"], clip: f["--clipboard"] });
      if (!value) die(`empty value; ${VALUE_HOW}`);
      const desc = f["-d"] ?? f["--description"];
      await adminCall("PUT", `keys/${encodeURIComponent(f["--scope"])}/${encodeURIComponent(name)}`, { value, ...(f["--kind"] ? { kind: f["--kind"] } : {}),
        ...(config !== undefined ? { config } : {}), ...(desc !== undefined ? { description: desc } : {}), ...(f["--skip-check"] ? { skip_check: true } : {}) });
      try { await ask({ op: "reload" }); } catch {}
      return say(`saved ${name} in ${f["--scope"]}`);
    }
    case "rm": {
      const f = adminFlags(rest, { "--scope": "value" });
      const [name] = f._;
      if (!name || f._.length > 1 || !f["--scope"]) die(ADMIN_USAGE, 2);
      await adminCall("DELETE", `keys/${encodeURIComponent(f["--scope"])}/${encodeURIComponent(name)}`);
      try { await ask({ op: "reload" }); } catch {}
      return say(`deleted ${name} from ${f["--scope"]}`);
    }
    case "import": {
      const f = adminFlags(rest, { "--scope": "value", "--save": "bool" });
      const [file] = f._;
      if (!file || f._.length > 1 || !f["--scope"]) die(ADMIN_USAGE, 2);
      let text; try { text = readFileSync(file, "utf8"); } catch (e) { die(`could not read ${file} (${e.code ?? e.message})`); }
      const r = await adminCall("POST", "import", { scope: f["--scope"], text, save: !!f["--save"] });
      for (const e of r.errors) say(`line ${e.line}: ${e.error}`);
      for (const k of r.keys) process.stdout.write(`${k.name}\t${k.action}${k.reason ? `\t${k.reason}` : ""}\n`);
      if (!f["--save"]) say("a preview; pass --save to save it");
      else if (r.saved.length) try { await ask({ op: "reload" }); } catch {}
      return;
    }
    case "move": {
      const f = adminFlags(rest, {});
      const [from, to] = f._;
      if (!from || !to || f._.length > 2) die(ADMIN_USAGE, 2);
      const r = await adminCall("POST", "scopes/move", { from, to });
      return say(`moved ${r.moved.length} key(s) from ${from} to ${to}; repinned ${r.repinned.join(", ") || "no tokens"}. Change project = ${from} in any .tumbler that names it`);
    }
    case "grant": {
      const f = adminFlags(rest.slice(1), {});
      if (rest[0] !== "revoke" || f._.length !== 1) die(ADMIN_USAGE, 2);
      await adminCall("DELETE", `grants/${encodeURIComponent(f._[0])}`);
      return say(`revoked grant ${f._[0]}`);
    }
    default: die(ADMIN_USAGE, 2);
  }
}

function shim(tools) {
  if (!tools.length) die("usage: tumbler shim <tool>...", 2);
  mkdirSync(SHIM_DIR, { recursive: true });
  for (const t of tools) {
    if (!/^[A-Za-z0-9._-]+$/.test(t)) die(`bad tool name: ${t}`, 2);
    const p = join(SHIM_DIR, t);
    writeFileSync(p, `#!/bin/sh\nTUMBLER_SHIMMED=1 exec "${SELF}" run -- ${t} "$@"\n`, { mode: 0o755 });
  }
  process.stdout.write(`shims in ${SHIM_DIR}; put it first on PATH\n`);
}

// --- the broker's URL: TUMBLER_URL, else the one saved with `tumbler url`, else asked for once ------

const URL_FILE = join(process.env.XDG_CONFIG_HOME || join(homedir(), ".config"), "tumbler", "url");
const savedUrl = () => { try { return readFileSync(URL_FILE, "utf8").trim() || null; } catch { return null; } };
function saveUrl(raw) {
  const url = withScheme(String(raw).trim()).replace(/\/+$/, "");
  try { if (!/^https?:$/.test(new URL(url).protocol)) throw 0; } catch { die(`not a URL: ${raw}`, 2); }
  mkdirSync(dirname(URL_FILE), { recursive: true });
  writeFileSync(URL_FILE, url + "\n");
  process.env.TUMBLER_URL = url;
  say(`broker URL set to ${url} (${URL_FILE})`);
}
async function ensureUrl() {
  // Set here, so the cache helper and the commands `run` starts inherit it like an exported variable.
  if (!process.env.TUMBLER_URL && savedUrl()) process.env.TUMBLER_URL = savedUrl();
  if (process.env.TUMBLER_URL) return;
  if (!process.stdin.isTTY) die(`TUMBLER_URL is not set; run \`tumbler url https://<your broker>\` once, or export TUMBLER_URL`);
  const { createInterface } = await import("node:readline/promises");
  const rl = createInterface({ input: process.stdin, output: process.stderr });
  const answer = await rl.question("tumbler: broker URL (e.g. https://tumbler.example.com): ");
  rl.close();
  if (!answer.trim()) die("no URL given; nothing was saved", 2);
  saveUrl(answer);
}

const [cmd, ...args] = process.argv.slice(2);
if (["run", "auto", "keys", "whoami", "put", "rm", "scope", "admin", "ssh-keygen", "update", "__daemon"].includes(cmd)) await ensureUrl();
switch (cmd) {
  case "url": {
    if (args.length > 1) die("usage: tumbler url [URL]", 2);
    if (args[0]) saveUrl(args[0]);
    else process.stdout.write((process.env.TUMBLER_URL || savedUrl() || "") + "\n");
    break;
  }
  case "__daemon": daemon(); break;
  case "run": await run(args); break;
  case "auto": await auto(args); break;
  case "keys": {
    const { project } = parseFlags(args);
    // Names only: /v1/env would mint a child for every minted key just to list it.
    try { process.stdout.write((await brokerGet("/v1/keys" + (project ? `?project=${encodeURIComponent(project)}` : ""))).keys.join("\n") + "\n"); } catch (e) { die(e.message); }
    break;
  }
  case "whoami": try { process.stdout.write(JSON.stringify(await brokerGet("/v1/whoami")) + "\n"); } catch (e) { die(e.message); } break;
  case "put": await put(args); break;
  case "rm": await rm(args); break;
  case "ssh-keygen": await sshKeygen(args); break;
  case "scope": await scope(args); break;
  case "update": await update(); break;
  case "admin": await admin(args); break;
  case "reload": try { await ask({ op: "reload" }); } catch {} process.stdout.write("cache cleared\n"); break;
  case "shim": shim(args); break;
  default: die("usage: tumbler run|auto|keys|whoami|put|rm|scope|admin|ssh-keygen|reload|shim|update|url  (see the header of this file)", 2);
}
