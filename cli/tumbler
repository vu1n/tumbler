#!/usr/bin/env node
// tumbler — run a command with env vars from the tumbler broker. Values live only in the process
// you run and in a short-lived in-memory cache; nothing is written to disk.
//
//   tumbler run [-p project] [-k A,B] -- <cmd> [args...]
//   tumbler keys [-p project]        names this caller can read (never values)
//   tumbler whoami                   which token the broker sees, and its pin
//   tumbler reload                   drop the cache so the next run fetches fresh values
//   tumbler shim <tool>...           install wrappers so <tool> always runs under `tumbler run`
//
// Config (environment): TUMBLER_URL (required), TUMBLER_TOKEN (optional: leave unset when the
// environment's network secret adds the Authorization header), TUMBLER_TTL seconds (default 300,
// 0 disables the cache), TUMBLER_PROJECT (default project). A `.tumbler` file in the working
// directory or any parent lists the key names a project wants, one per line, plus an optional
// `project = <name>` line.
import { execFile, spawn } from "node:child_process";
import { createHash } from "node:crypto";
import { chmodSync, existsSync, mkdirSync, readFileSync, unlinkSync, writeFileSync } from "node:fs";
import { createConnection, createServer } from "node:net";
import { homedir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const SELF = fileURLToPath(import.meta.url);
const TTL = Number(process.env.TUMBLER_TTL ?? 300) * 1000;
const RUN_DIR = join(process.env.XDG_RUNTIME_DIR || join(homedir(), ".cache"), "tumbler");
const SOCK = join(RUN_DIR, `cache-${process.getuid?.() ?? 0}.sock`);
const SHIM_DIR = join(homedir(), ".local", "share", "tumbler", "bin");
const IDLE_EXIT = Number(process.env.TUMBLER_IDLE ?? 1800) * 1000; // the helper exits after this long unused

const die = (msg, code = 1) => { process.stderr.write(`tumbler: ${msg}\n`); process.exit(code); };

// --- talking to the broker -------------------------------------------------------------------

// Why curl: it honours HTTPS_PROXY and the proxy's CA bundle everywhere, which Node's fetch does
// not by default, and the agent proxy is what attaches the network secret.
const callerCfg = () => ({ url: process.env.TUMBLER_URL, token: process.env.TUMBLER_TOKEN || "" });

function brokerGet(path, { url: base, token } = callerCfg()) {
  if (!base) return Promise.reject(new Error("TUMBLER_URL is not set"));
  return new Promise((ok, fail) => {
    const child = execFile("curl", ["-sS", "--max-time", "15", "-H", "@-", "-w", "\n%{http_code}", base.replace(/\/$/, "") + path],
      { maxBuffer: 4 << 20 }, (err, stdout, stderr) => {
        if (err && !stdout) return fail(new Error(stderr.trim() || err.message));
        const i = stdout.lastIndexOf("\n"), status = Number(stdout.slice(i + 1)), body = stdout.slice(0, i);
        let parsed; try { parsed = JSON.parse(body); } catch { parsed = { error: body.slice(0, 200) }; }
        status >= 200 && status < 300 ? ok(parsed) : fail(new Error(`broker ${status}: ${parsed.error ?? "error"}`));
      });
    // The token goes in on stdin, so it never shows up in `ps`.
    child.stdin.end(token ? `Authorization: Bearer ${token}\n` : "");
  });
}

const envPath = (project, keys) => {
  const q = new URLSearchParams();
  if (project) q.set("project", project);
  if (keys.length) q.set("keys", keys.join(","));
  const s = q.toString();
  return "/v1/env" + (s ? `?${s}` : "");
};

// --- the in-memory cache (a lazily started helper on a private unix socket) ------------------

function daemon() {
  mkdirSync(RUN_DIR, { recursive: true, mode: 0o700 });
  chmodSync(RUN_DIR, 0o700);
  const cache = new Map();
  let idle = setTimeout(() => process.exit(0), IDLE_EXIT);
  const server = createServer((sock) => {
    clearTimeout(idle); idle = setTimeout(() => process.exit(0), IDLE_EXIT);
    let buf = "";
    sock.on("data", async (d) => {
      buf += d;
      if (!buf.includes("\n")) return;
      const reply = (o) => sock.end(JSON.stringify(o) + "\n");
      try {
        const req = JSON.parse(buf);
        if (req.op === "reload") { cache.clear(); return reply({ ok: true }); }
        // Why: the cache is keyed by broker and token too, so a caller with another token never
        // gets values fetched for someone else.
        const path = envPath(req.project, req.keys), slot = createHash("sha256").update(`${req.url}\0${req.token}\0${path}`).digest("hex");
        const hit = cache.get(slot);
        if (hit && Date.now() - hit.at < TTL) return reply({ env: hit.env });
        const { env } = await brokerGet(path, { url: req.url, token: req.token });
        cache.set(slot, { at: Date.now(), env });
        reply({ env });
      } catch (e) { reply({ error: e.message }); }
    });
  });
  if (existsSync(SOCK)) unlinkSync(SOCK);
  const old = process.umask(0o077);
  server.listen(SOCK, () => process.umask(old));
}

function ask(req) {
  return new Promise((ok, fail) => {
    const sock = createConnection(SOCK);
    let buf = "";
    sock.on("connect", () => sock.write(JSON.stringify(req) + "\n"));
    sock.on("data", (d) => { buf += d; });
    sock.on("end", () => { try { ok(JSON.parse(buf)); } catch (e) { fail(e); } });
    sock.on("error", fail);
  });
}

async function cached(req) {
  try { return await ask(req); } catch {}
  spawn(process.execPath, [SELF, "__daemon"], { detached: true, stdio: "ignore", env: process.env }).unref();
  for (let i = 0; i < 40; i++) {
    await new Promise((r) => setTimeout(r, 50));
    try { return await ask(req); } catch {}
  }
  return null; // helper didn't come up; caller fetches directly
}

async function fetchEnv(project, keys) {
  if (TTL > 0) {
    const r = await cached({ op: "get", project, keys, ...callerCfg() });
    if (r?.error) throw new Error(r.error);
    if (r?.env) return r.env;
  }
  return (await brokerGet(envPath(project, keys))).env;
}

// --- project manifest ------------------------------------------------------------------------

function manifest() {
  for (let dir = process.cwd(); ; dir = dirname(dir)) {
    const f = join(dir, ".tumbler");
    if (existsSync(f)) {
      const out = { project: null, keys: [] };
      for (const raw of readFileSync(f, "utf8").split("\n")) {
        const line = raw.replace(/#.*/, "").trim();
        if (!line) continue;
        const m = /^project\s*=\s*(\S+)$/.exec(line);
        if (m) out.project = m[1]; else out.keys.push(line);
      }
      return out;
    }
    if (dirname(dir) === dir) return { project: null, keys: [] };
  }
}

function parseFlags(args) {
  const m = manifest();
  let project = process.env.TUMBLER_PROJECT || m.project, keys = m.keys, rest = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === "--") { rest = args.slice(i + 1); break; }
    if (a === "-p" || a === "--project") project = args[++i];
    else if (a === "-k" || a === "--keys") keys = String(args[++i] ?? "").split(",").map((s) => s.trim()).filter(Boolean);
    else { rest = args.slice(i); break; }
  }
  return { project, keys, rest };
}

// --- commands --------------------------------------------------------------------------------

function realBinary(tool) {
  // The first `tool` on PATH that isn't one of our shims.
  for (const dir of (process.env.PATH ?? "").split(":")) {
    if (!dir || resolve(dir) === SHIM_DIR) continue;
    const p = join(dir, tool);
    if (existsSync(p)) return p;
  }
  return null;
}

async function run(args) {
  const { project, keys, rest } = parseFlags(args);
  if (!rest.length) die("usage: tumbler run [-p project] [-k A,B] -- <cmd> [args...]", 2);
  let env;
  try { env = await fetchEnv(project, keys); } catch (e) { die(e.message); }
  // Why: under a shim, `rest[0]` is the shim's own name; resolve past the shim dir so it can't loop.
  const cmd = process.env.TUMBLER_SHIMMED ? realBinary(rest[0]) ?? die(`no ${rest[0]} on PATH outside the shims`, 127) : rest[0];
  const child = spawn(cmd, rest.slice(1), { stdio: "inherit", env: { ...process.env, ...env, TUMBLER_SHIMMED: "" } });
  for (const sig of ["SIGINT", "SIGTERM", "SIGHUP"]) process.on(sig, () => child.kill(sig));
  child.on("error", (e) => die(`${rest[0]}: ${e.message}`, 127));
  child.on("exit", (code, sig) => (sig ? process.kill(process.pid, sig) : process.exit(code ?? 1)));
}

function shim(tools) {
  if (!tools.length) die("usage: tumbler shim <tool>...", 2);
  mkdirSync(SHIM_DIR, { recursive: true });
  for (const t of tools) {
    if (!/^[A-Za-z0-9._-]+$/.test(t)) die(`bad tool name: ${t}`, 2);
    const p = join(SHIM_DIR, t);
    writeFileSync(p, `#!/bin/sh\nTUMBLER_SHIMMED=1 exec "${SELF}" run -- ${t} "$@"\n`, { mode: 0o755 });
  }
  process.stdout.write(`shims in ${SHIM_DIR}; put it first on PATH\n`);
}

const [cmd, ...args] = process.argv.slice(2);
switch (cmd) {
  case "__daemon": daemon(); break;
  case "run": await run(args); break;
  case "keys": {
    const { project } = parseFlags(args);
    try { process.stdout.write(Object.keys(await fetchEnv(project, [])).sort().join("\n") + "\n"); } catch (e) { die(e.message); }
    break;
  }
  case "whoami": try { process.stdout.write(JSON.stringify(await brokerGet("/v1/whoami")) + "\n"); } catch (e) { die(e.message); } break;
  case "reload": try { await ask({ op: "reload" }); } catch {} process.stdout.write("cache cleared\n"); break;
  case "shim": shim(args); break;
  default: die("usage: tumbler run|keys|whoami|reload|shim  (see the header of this file)", 2);
}
