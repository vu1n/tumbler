{
  "name": "tumbler",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Create it once with `npx wrangler d1 create tumbler` and put its id here, so migrations (which
  // run before each deploy) and CI deploys always reach the same database.
  "d1_databases": [
    { "binding": "DB", "database_name": "tumbler", "database_id": "<your-d1-database-id>", "migrations_dir": "migrations" }
  ],
  // The one secret tumbler needs: a 32-byte base64 master key (`openssl rand -base64 32`) in a
  // Cloudflare Secrets Store. Every value in D1 is sealed under it. Fill in your store id.
  "secrets_store_secrets": [
    { "binding": "MASTER_KEY", "store_id": "<your-secrets-store-id>", "secret_name": "tumbler-master-key" }
  ],
  // Per-install, set on the Worker (dashboard or `wrangler deploy --var`); keep_vars keeps them.
  // ACCESS_TEAM_DOMAIN: "<team>.cloudflareaccess.com". ACCESS_AUD: the Access application's AUD tag.
  // TUMBLER_ADMINS: comma-separated emails allowed into /admin.
  "keep_vars": true,
  // Clef (System One on Workers AI) picks keys for `tumbler auto` when the rules don't settle them.
  // TUMBLER_AUTO_MODEL var: "clef" (default) or "clef-flash".
  "ai": { "binding": "AI" },
  // Expires minted grants and deletes their children at the provider (see src/grants.ts sweep).
  "triggers": { "crons": ["*/5 * * * *"] },
  // Serves cli/tumbler at /cli, so setup scripts install the CLI straight from the broker.
  "rules": [{ "type": "Text", "globs": ["**/cli/tumbler"], "fallthrough": false }]
}
